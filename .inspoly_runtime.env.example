# Copy this file to .inspoly_runtime.env for local runs.
# Do not commit .inspoly_runtime.env.

# Start safely without live Polygon RPC calls.
INSPOLY_FUNDING_TRACE_MODE=disabled

# Optional modes:
# INSPOLY_FUNDING_TRACE_MODE=cache_only
# INSPOLY_FUNDING_TRACE_MODE=live_rpc

# Optional RPC configuration. Use only non-secret public endpoints here.
# If your endpoint includes a private key, keep it only in .inspoly_runtime.env.
# INSPOLY_POLYGON_RPC_URLS=https://polygon-rpc.com

# Optional advisory LLM review. This is not production scoring.
# INSPOLY_LLM_PROVIDER=openai
# INSPOLY_LLM_MODEL=
# OPENAI_API_KEY=

